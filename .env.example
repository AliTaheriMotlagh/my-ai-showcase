# Public URL of the site. Used for canonical links, the sitemap, Open Graph images and the auth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres connection string (Neon, Supabase, Vercel Postgres, or local Docker).
# Use the pooled URL for the app. DATABASE_URL_UNPOOLED (direct connection) is used for migrations when set.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/latent
# DATABASE_URL_UNPOOLED=postgres://...

# Session signing secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Only needed if the auth origin differs from NEXT_PUBLIC_SITE_URL.
# BETTER_AUTH_URL=https://example.com

# Vercel Blob read/write token for avatars, banners, images, video, audio and 3D models.
BLOB_READ_WRITE_TOKEN=
